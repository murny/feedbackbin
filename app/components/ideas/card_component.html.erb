<li id="<%= dom_id @idea %>" class="panel panel--interactive"
    data-navigable-list-target="item"
    tabindex="-1">
  <div class="pad-inline">
    <div class="flex gap" style="--column-gap: var(--space-3);">
      <%= render partial: "votes/vote_button", locals: { voteable: @idea } %>
      <div class="flex-item-grow flex flex-column gap-3">
        <div class="flex align-start justify-space-between full-width gap-half margin-block-end-half">
          <h2 class="flex-1">
            <%= helpers.link_to @idea.title, @idea, class: "txt-x-large font-weight-bold overflow-line-clamp txt-undecorated", style: "--lines: 2;", data: { navigable_list_primary_action: "" } %>
          </h2>
          <div class="flex align-center gap-half flex-item-no-shrink">
            <% if @idea.pinned? %>
              <%= render Elements::BadgeComponent.new(variant: :secondary) do %>
                <%= helpers.lucide_icon "map-pin" %>
                <%= t("ideas.idea.pinned") %>
              <% end %>
            <% end %>
            <%= render Elements::BadgeComponent.new(color: @idea.status_color) do %>
              <%= @idea.status_name %>
            <% end %>
          </div>
        </div>

        <%= render "ideas/idea/metadata", idea: @idea %>

        <div class="margin-block-start-half flex align-center gap-half txt-x-small">
          <%= helpers.avatar_tag @idea.creator, class: "avatar avatar--sm", alt: @idea.creator.name %>
          <p>
            <%= helpers.link_to @idea.creator.name, @idea.creator, class: "txt-undecorated" %>
          </p>
          <%= helpers.lucide_icon "dot" %>
          <p>
            <%= helpers.time_ago_with_tooltip @idea.created_at %>
          </p>
        </div>
        <p class="margin-block-start-half txt-subtle txt-small">
          <%= truncate(strip_tags(@idea.description.to_s), length: 250, separator: " ") %>
        </p>

        <div class="flex align-center justify-space-between pad-block-start-half" style="padding-inline-end: var(--space-2);">
          <% avatars = participant_avatars %>
          <% if avatars.any? %>
            <%= render Elements::AvatarGroupComponent.new(avatars, hover_effect: true) %>
          <% end %>
          <div class="flex align-center gap-half">
            <div>
              <span class="visually-hidden"><%= t("ideas.idea.total_comments") %></span>
              <svg class="size-6 txt-subtle" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 011.037-.443 48.282 48.282 0 005.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
              </svg>
            </div>
            <div class="txt-small"><%= @idea.comments_count %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</li>
