<% content_for(:title) { t("user_settings.watches.show.title") } %>

<div class="container">
  <%= render partial: "user_settings/header" %>

  <div class="margin-block-start-double">
    <div class="panel" style="padding: var(--space-6);">
      <div class="flex flex-column gap-6">
        <div class="flex align-start justify-space-between gap-4">
          <div>
            <h2 class="txt-large font-weight-medium"><%= t("user_settings.watches.show.title") %></h2>
            <p class="txt-small txt-subtle"><%= t("user_settings.watches.show.description") %></p>
          </div>

          <% if @watches.any? %>
            <div data-controller="dialog"
                 data-dialog-modal-value="true"
                 data-action="keydown.esc->dialog#close">
              <%= render Elements::ButtonComponent.new(
                    variant: :destructive,
                    size: :sm,
                    data: { action: "click->dialog#open:stop" }
                  ) do %>
                <%= lucide_icon "bell-off", class: "size-4" %>
                <%= t("user_settings.watches.show.bulk_unwatch") %>
              <% end %>

              <dialog id="bulk-unwatch-dialog"
                      class="dialog"
                      data-dialog-target="dialog"
                      data-action="turbo:before-morph-attribute->dialog#preventCloseOnMorphing">
                <article class="dialog__content">
                  <header class="dialog__header">
                    <h2 class="dialog__title"><%= t("user_settings.watches.show.bulk_confirm_title") %></h2>
                    <p class="dialog__description"><%= t("user_settings.watches.show.bulk_confirm_body", count: @watches.count) %></p>
                  </header>
                  <footer class="dialog__footer flex justify-end gap-3">
                    <%= render Elements::ButtonComponent.new(
                          variant: :outline,
                          data: { action: "click->dialog#close" }
                        ) do %>
                      <%= t("user_settings.watches.show.bulk_cancel") %>
                    <% end %>
                    <%= button_to t("user_settings.watches.show.bulk_confirm_action"),
                          bulk_user_settings_watches_path,
                          method: :delete,
                          class: "btn btn--destructive btn-to" %>
                  </footer>
                </article>
              </dialog>
            </div>
          <% end %>
        </div>

        <% if @watches.any? %>
          <div class="watch-list">
            <%= render partial: "row", collection: @watches, as: :watch %>
          </div>
        <% else %>
          <%= render Elements::EmptyStateComponent.new(
                icon: "bell-off",
                title: t("user_settings.watches.show.empty_title"),
                description: t("user_settings.watches.show.empty_description")
              ) do |c| %>
            <% c.with_cta do %>
              <%= link_to t("user_settings.watches.show.empty_cta"), ideas_path, class: "btn btn--outline" %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
