<%# locals: (watch:) %>
<div id="<%= dom_id(watch) %>" class="watch-list__row">
  <div class="watch-list__row__main">
    <%= link_to watch.idea.title, idea_path(watch.idea), class: "watch-list__row__title" %>
    <p class="watch-list__row__meta txt-small txt-subtle">
      <%= t("user_settings.watches.show.row_meta",
            date: l(watch.created_at.to_date),
            votes: watch.idea.votes_count,
            comments: watch.idea.comments_count) %>
    </p>
  </div>

  <div class="watch-list__row__actions">
    <%= button_to user_settings_watch_path(watch),
          method: :delete,
          class: "btn btn--outline btn--sm btn-to",
          form: { class: "watch-list__row__form" },
          "aria-label": t("user_settings.watches.show.unwatch_action"),
          title: t("user_settings.watches.show.unwatch_tooltip") do %>
      <%= lucide_icon "bell-off", class: "size-4" %>
      <span class="visually-hidden"><%= t("user_settings.watches.show.unwatch_action") %></span>
    <% end %>
  </div>
</div>
