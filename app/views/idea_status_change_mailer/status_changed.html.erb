<p><%= t(".greeting", name: @recipient.name) %></p>

<p><%= t(".status_changed_html", title: @idea.title, old_status: @old_status, new_status: @new_status) %></p>

<p>
  <%= render Elements::ButtonComponent.new(href: idea_url(@idea), variant: :default) do %>
    <%= t(".view_idea") %>
  <% end %>
</p>

<p><%= t(".signature") %></p>

<hr>
<p style="font-size: 12px; color: #666;">
  <%= t(".footer_reason", title: @idea.title) %>
  <a href="<%= unsubscribe_url(token: unwatch_token_for(@idea, @recipient)) %>" style="color: #06c; text-decoration: underline;"><%= t(".footer_unwatch") %></a>
</p>
