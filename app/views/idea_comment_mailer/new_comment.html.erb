<p><%= t(".heading") %></p>

<p><%= t(".lead", commenter: @commenter.name, title: @idea.title) %></p>

<blockquote><%= @comment.body.to_plain_text %></blockquote>

<p>
  <%= render Elements::ButtonComponent.new(href: idea_url(@idea, anchor: "comment_#{@comment.id}"), variant: :default) do %>
    <%= t(".cta") %>
  <% end %>
</p>

<hr>
<p style="font-size: 12px; color: #666;">
  <%= t(".footer_reason", title: @idea.title) %>
  <form action="<%= unsubscribe_destroy_by_token_url(token: unwatch_token_for(@idea, @recipient)) %>" method="post" style="display: inline;">
    <button type="submit" style="background: none; border: 0; color: #06c; padding: 0; cursor: pointer; text-decoration: underline; font: inherit;"><%= t(".footer_unwatch") %></button>
  </form>
</p>
